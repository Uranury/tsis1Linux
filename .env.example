# Copy to .env for local use (or export these directly in the shell / systemd
# unit — see CLAUDE.md, the app does not load .env files itself).

PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/tsis1linux?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
